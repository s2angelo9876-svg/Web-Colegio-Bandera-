# =====================================================================
# Backend — Variables de Entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` al repositorio (ya está en .gitignore).
# =====================================================================

# Entorno: 'development' | 'production'
NODE_ENV=development

# Puerto del servidor Express
PORT=3000

# Secreto para firmar tokens JWT.
# Genera uno seguro con:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_largo

# =====================================================================
# Base de datos (Supabase / PostgreSQL)
# Pegar la "Connection string" desde Supabase → Project Settings → Database
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# =====================================================================
DATABASE_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres

# =====================================================================
# URL pública del frontend (para CORS y redirecciones)
# =====================================================================
FRONTEND_URL=http://localhost:5173

# =====================================================================
# Nodemailer — Mesa de Partes
# IMPORTANTE: usa una "App Password" de Gmail, NO tu contraseña real.
# https://myaccount.google.com/apppasswords
# =====================================================================
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_de_16_caracteres
EMAIL_FROM="Mesa de Partes I.E. Bandera del Perú <tu_correo@gmail.com>"

# =====================================================================
# Supabase Storage — Imágenes y PDFs
# Obtener desde Supabase → Project Settings → API
# =====================================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_secreta
SUPABASE_BUCKET=colegio-archivos
