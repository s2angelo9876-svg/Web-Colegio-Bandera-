# =====================================================================
# Frontend — Variables de Entorno (Vite)
# Copia este archivo a `.env` y completa los valores reales.
# Solo las variables con prefijo VITE_ se exponen al bundle del navegador.
# =====================================================================

# URL base de la API del backend
# - Local:      http://localhost:3000/api
# - Producción: https://web-colegio-bandera-backend.onrender.com/api
VITE_API_URL=https://web-colegio-bandera-backend.onrender.com/api

# URL base para servir archivos subidos (imágenes, PDFs).
# En producción los archivos viven en Supabase Storage; este fallback
# apunta al backend por si necesitas acceder a /uploads legacy.
VITE_UPLOADS_URL=https://web-colegio-bandera-backend.onrender.com/uploads
