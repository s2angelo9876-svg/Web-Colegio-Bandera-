# =====================================================================
# Frontend — Variables de Entorno (Vite)
# Copia este archivo a `.env` y completa los valores reales.
# =====================================================================

# URL base de la API del backend
# - Local:      http://localhost:3000/api
# - Producción: https://tu-backend.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# URL base para servir archivos subidos.
# Si el backend está en Supabase Storage, será la URL pública del bucket.
# Si se conserva /uploads local, será la URL del backend.
VITE_UPLOADS_URL=http://localhost:3000/uploads
