# syntax=docker/dockerfile:1
FROM php:8.6-fpm-bookworm

RUN --mount=type=bind,source=php/deploy/install-runtime.sh,target=/tmp/install-runtime.sh \
    sh /tmp/install-runtime.sh openssl tini
COPY --link --from=caddy:2-alpine /usr/bin/caddy /usr/bin/caddy

WORKDIR /app
COPY --link --chmod=a=rX php/ /app/
ENV PHP_INI_SCAN_DIR=/usr/local/etc/php/conf.d:/app/deploy/vps
EXPOSE 8080
STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["bash", "/app/deploy/railway/entrypoint.sh", "serve"]
